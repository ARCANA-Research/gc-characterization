+
+void
+CacheMemory::profileJdkDemandHit(Addr address, bool isJdk,
+    bool isJdkLoad, bool isGC, bool isNonGC)
+{
+    if (isJdk) {
+        if (isJdkLoad) {
+            if (isGC) {
+                cacheMemoryStats.m_gc_load_demand_hits++;
+                DPRINTF(RubyCache, "JDKERROR: gc load hit for addr: %#x\n",
+                address);
+            } else if (isNonGC) {
+                cacheMemoryStats.m_non_gc_load_demand_hits++;
+                DPRINTF(RubyCache,
+                    "JDKERROR: non gc load hit for addr: %#x\n",
+                    address);
+            } else {
+              panic("JDKERROR: Unknown load request hit [%d %d %d %d]",
+                isJdk, isJdkLoad, isGC, isNonGC);
+            }
+        } else {
+            if (isGC) {
+                cacheMemoryStats.m_gc_store_demand_hits++;
+                DPRINTF(RubyCache, "JDKERROR: gc store hit for addr: %#x\n",
+                address);
+            } else if (isNonGC) {
+                cacheMemoryStats.m_non_gc_store_demand_hits++;
+                DPRINTF(RubyCache,
+                    "JDKERROR: non gc store hit for addr: %#x\n",
+                    address);
+            } else {
+              panic("JDKERROR: Unknown store request hit [%d %d %d %d]",
+                isJdk, isJdkLoad, isGC, isNonGC);
+            }
+        }
+    }
+}
+
+
+void
+CacheMemory::profileJdkDemandMiss(Addr address, bool isJdk,
+    bool isJdkLoad, bool isGC, bool isNonGC)
+{
+    if (isJdk) {
+        if (isJdkLoad) {
+            if (isGC) {
+                cacheMemoryStats.m_gc_load_demand_misses++;
+                DPRINTF(RubyCache, "JDKERROR: gc load miss for addr: %#x\n",
+                    address);
+            } else if (isNonGC) {
+                cacheMemoryStats.m_non_gc_load_demand_misses++;
+                DPRINTF(RubyCache,
+                    "JDKERROR: non gc load miss for addr: %#x\n",
+                    address);
+            } else {
+              panic("JDKERROR: Unknown load request miss [%d %d %d %d]",
+                isJdk, isJdkLoad, isGC, isNonGC);
+            }
+        } else {
+            if (isGC) {
+                cacheMemoryStats.m_gc_store_demand_misses++;
+                DPRINTF(RubyCache, "JDKERROR: gc store miss for addr: %#x\n",
+                    address);
+            } else if (isNonGC) {
+                cacheMemoryStats.m_non_gc_store_demand_misses++;
+                DPRINTF(RubyCache,
+                    "JDKERROR: non gc store miss for addr: %#x\n",
+                    address);
+            } else {
+              panic("JDKERROR: Unknown store request miss [%d %d %d %d]",
+                isJdk, isJdkLoad, isGC, isNonGC);
+            }
+        }
+    }
+}
+
+
+void
+CacheMemory::profileJdkInit(Addr address, AbstractCacheEntry* entry)
+{
+    if (entry->isJdk) {
+        if (entry->isAllocatedByGC) {
+            cacheMemoryStats.m_demand_gc_lines_allocated++;
+            DPRINTF(RubyCache, "JDKERROR: gc allocate addr: %#x\n",
+            address);
+        } else if (entry->isAllocatedByNonGC) {
+            cacheMemoryStats.m_demand_non_gc_lines_allocated++;
+            DPRINTF(RubyCache, "JDKERROR: non gc allocate addr: %#x\n",
+            address);
+        } else {
+          panic("JDKERROR: Unknown JDK line allocate [%d %d %d]",
+            entry->isJdk, entry->isAllocatedByGC, entry->isAllocatedByNonGC);
+        }
+    }
+}
+
+
+void
+CacheMemory::profileJdkAccess(Addr address, bool requestIsJdk,
+        bool requestIsGC, bool requestIsNonGC, AbstractCacheEntry* entry)
+{
+    if (requestIsJdk && entry->isJdk) {
+        if (requestIsGC) {
+            if (entry->isAllocatedByGC) {
+                cacheMemoryStats.m_num_gc_lines_accessed_by_gc++;
+                if (!entry->isOnceAccessedByGC) {
+                    entry->isOnceAccessedByGC = true;
+                    cacheMemoryStats.m_lines_allocated_by_gc_accessed_by_gc++;
+                }
+            } else if (entry->isAllocatedByNonGC) {
+                cacheMemoryStats.m_num_non_gc_lines_accessed_by_gc++;
+                if (!entry->isOnceAccessedByGC) {
+                    entry->isOnceAccessedByGC = true;
+                    cacheMemoryStats
+                        .m_lines_allocated_by_non_gc_accessed_by_gc++;
+                }
+            } else {
+                panic("JDKERROR: Unknown JDK line allocation addr: %#x",
+                    address);
+            }
+        } else if (requestIsNonGC) {
+            if (entry->isAllocatedByGC) {
+                cacheMemoryStats.m_num_gc_lines_accessed_by_non_gc++;
+                if (!entry->isOnceAccessedByNonGC) {
+                    entry->isOnceAccessedByNonGC = true;
+                    cacheMemoryStats
+                        .m_lines_allocated_by_gc_accessed_by_non_gc++;
+                }
+            } else if (entry->isAllocatedByNonGC) {
+                cacheMemoryStats.m_num_non_gc_lines_accessed_by_non_gc++;
+                if (!entry->isOnceAccessedByNonGC) {
+                    entry->isOnceAccessedByNonGC = true;
+                    cacheMemoryStats
+                        .m_lines_allocated_by_non_gc_accessed_by_non_gc++;
+                }
+            } else {
+                panic("JDKERROR: Unknown JDK line allocation addr: %#x",
+                    address);
+            }
+        } else {
+            panic("JDKERROR: Unknown JDK line allocate [%d %d %d]",
+                requestIsJdk, requestIsGC, requestIsNonGC);
+        }
+    }
+}
