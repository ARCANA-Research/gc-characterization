+#ifndef __MEM_RAMULATOR2_HH__
+#define __MEM_RAMULATOR2_HH__
+
+#include <deque>
+#include <functional>
+#include <unordered_map>
+
+#include "mem/abstract_mem.hh"
+#include "params/Ramulator2.hh"
+
+
+#include <zfstream.h>
+
