+bool
+System::isGC(uint64_t threadid)
+{
+    return (gcThreadSet.find(threadid) != gcThreadSet.end())
+        || (getExecutionPhase() >= 2);
+}
+
+
+bool
+System::isNonGC(uint64_t threadid)
+{
+    // return true;
+    // return (threadid != 0) && (!isGC(threadid));
+    return !isGC(threadid);
+}
+
+
+bool
+System::isGCThread(uint64_t threadid)
+{
+    return (gcThreadSet.find(threadid) != gcThreadSet.end());
+}
+
+
+void
+System::addGCThread(uint64_t threadid)
+{
+    assert(gcThreadSet.find(threadid) == gcThreadSet.end());
+    warn("JDKINFO: ADDING GC THREAD TID %d", threadid);
+    gcThreadSet.insert(threadid);
+}
+
+
+void
+System::removeGCThread(uint64_t threadid)
+{
+    assert(gcThreadSet.find(threadid) != gcThreadSet.end());
+    warn("JDKINFO: REMOVING GC THREAD TID %d", threadid);
+    gcThreadSet.erase(threadid);
+}
+
+
+uint
+System::getExecutionPhase() {
+    return executionPhase;
+}
+
+
+void
+System::setExecutionPhase(uint _execution_phase) {
+    executionPhase = _execution_phase;
+    rootStats.statJdkPhase = rootStats.currentJdkPhase;
+    rootStats.currentJdkPhase = executionPhase;
+    if (ramulator2Ptr == nullptr) {
+        findRamulator2Ptr();
+    }
+    ramulator2Ptr->changeExecutionPhase(executionPhase);
+}
+
+
+void
+System::findRamulator2Ptr()
+{
+    if (ramulator2Ptr == nullptr) {
+        warn("JDKINFO: Finding Ramulator2");
+        for (auto & simobj : SimObject::getSimObjectList()) {
+            if (dynamic_cast<gem5::memory::Ramulator2*>(simobj) != nullptr) {
+                warn("JDKINFO: Found Ramulator2 -> %s %s",
+                    simobj->name(), typeid(*simobj).name());
+                ramulator2Ptr =
+                    dynamic_cast<gem5::memory::Ramulator2*>(simobj);
+                return;
+            }
+        }
+    }
+    panic("JDKERROR: Ramulator2 Not Found");
+}
+
+
+
 } // namespace gem5
