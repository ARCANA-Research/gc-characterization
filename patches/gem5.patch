+
+void
+jdk_startroi(ThreadContext *tc)
+{
+    warn("JDKM5: START ROI");
+    assert(!tc->getSystemPtr()->inRoi);
+    tc->getSystemPtr()->inRoi = true;
+    jdk_gcevent(tc, 1);
+}
+
+
+void
+jdk_stoproi(ThreadContext *tc)
+{
+    warn("JDKM5: STOP ROI");
+    assert(tc->getSystemPtr()->inRoi);
+    jdk_gcevent(tc, 0);
+    tc->getSystemPtr()->inRoi = false;
+}
+
+
+void
+jdk_gcevent(ThreadContext *tc, uint64_t eventid)
+{
+    warn("JDKM5: GC EVENT ID (%d)", eventid);
+    if (!tc->getSystemPtr()->inRoi) {
+        warn("JDKINFO: NOT IN ROI -> IGNORING EVENT");
+        return;
+    }
+    if (eventid != tc->getSystemPtr()->getExecutionPhase()) {
+        if (dynamic_cast<BaseKvmCPU*>(tc->getCpuPtr()) != nullptr) {
+            warn("JDKINFO: NOT DUMPING STATS AS IN KVM CPU");
+        } else {
+            assert(tc->getCpuPtr()->params().do_statistics_insts);
+            warn("JDKINFO: DUMP AND RESET STATS FOR PHASE: %d",
+                tc->getSystemPtr()->getExecutionPhase());
+            dumpresetstats(tc, 0, 0);
+        }
+        warn("JDKINFO: CHANGING TO EXECUTION PHASE: %d", eventid);
+        tc->getSystemPtr()->setExecutionPhase(eventid);
+    } else {
+        warn("JDKINFO: REPETITIVE EXECUTION PHASE CHANGE CALL: %d", eventid);
+    }
+}
+
+
+void
+jdk_gcthreadstart(ThreadContext *tc, uint64_t threadid)
+{
+    warn("JDKM5: GC THREAD START (%d)", threadid);
+    assert(!tc->getSystemPtr()->isGCThread(threadid));
+    tc->getSystemPtr()->addGCThread(threadid);
+}
+
+
+void
+jdk_gcthreadend(ThreadContext *tc, uint64_t threadid)
+{
+    warn("JDKM5: GC THREAD END (%d)", threadid);
+    assert(tc->getSystemPtr()->isGCThread(threadid));
+    tc->getSystemPtr()->removeGCThread(threadid);
+}
+
 } // namespace pseudo_inst
 } // namespace gem5
