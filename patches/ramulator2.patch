+  };
+
+  int type_id = -1;    // An identifier for the type of the request
+  int source_id = -1;  // An identifier for where the request is coming from (e.g., which core)
+
+  int command = -1;          // The command that need to be issued to progress the request
+  int final_command = -1;    // The final command that is needed to finish the request
+  bool is_stat_updated = false; // Memory controller stats
+
+  Clk_t arrive = -1;   // Clock cycle when the request arrive at the memory controller
+  Clk_t depart = -1;   // Clock cycle when the request depart the memory controller
+
+  Clk_t active_clk = -1;     // Clock cycle when request is selected from the active buffer
+  Clk_t priority_clk = -1;   // Clock cycle when request is selected from the priority buffer
+  Clk_t rdwr_clk = -1;       // Clock cycle when request is selected from the RD/WR buffers
+
+  std::array<int, 4> scratchpad = { 0 };    // A scratchpad for the request
+
+  std::function<void(Request&)> callback;
+
+  void* m_payload = nullptr;    // Point to a generic payload
+
+  int jdk_id = Jdk::Unknown;
+  int jdk_phase = 0;
+  Addr_t vaddr;
+  bool is_retry = false;
+
+  Request(Addr_t addr, int type);
+  Request(AddrVec_t addr_vec, int type);
+  Request(Addr_t addr, int type, int jdk_id);
+  Request(Addr_t addr, int type, int source_id, std::function<void(Request&)> callback);
+  Request(Addr_t addr, int type, int source_id, std::function<void(Request&)> callback, int jdk_id);
+  Request(Addr_t addr, int type, int source_id, std::function<void(Request&)> callback, int jdk_id, Addr_t vaddr, bool is_retry);
+};
+
+
+struct ReqBuffer {
+  std::list<Request> buffer;
+  size_t max_size = 32;
+
+  int num_gc_reqs = 0;
+  int num_nongc_reqs = 0;
+  int num_non_jdk_reqs = 0;
+
+
+  using iterator = std::list<Request>::iterator;
+  iterator begin() { return buffer.begin(); };
+  iterator end() { return buffer.end(); };
+
+
+  size_t size() const { return buffer.size(); }
+
+  bool enqueue(const Request& request) {
+    if (buffer.size() <= max_size) {
+      buffer.push_back(request);
+      if (request.jdk_id == Request::Jdk::GC) {
+        num_gc_reqs += 1;
+      } else if (request.jdk_id == Request::Jdk::NonGC) {
+        num_nongc_reqs += 1;
+      } else {
+        num_non_jdk_reqs += 1;
+      }
+      assert((num_gc_reqs + num_nongc_reqs + num_non_jdk_reqs) == buffer.size());
+      return true;
+    } else {
+      return false;
+    }
+  }
+
+  void remove(iterator it) {
+    if ((*it).jdk_id == Request::Jdk::GC) {
+      num_gc_reqs -= 1;
+      assert(num_non_jdk_reqs >= 0);
+    } else if ((*it).jdk_id == Request::Jdk::NonGC) {
+      num_nongc_reqs -= 1;
+      assert(num_non_jdk_reqs >= 0);
+    } else {
+      num_non_jdk_reqs -= 1;
+      assert(num_non_jdk_reqs >= 0);
+    }
+    buffer.erase(it);
+  }
+};
+
+struct PendingBuffer {
+  std::deque<Request> pending;
+
+  size_t num_gc_reqs = 0;
+  size_t num_nongc_reqs = 0;
+  size_t num_non_jdk_reqs = 0;
+
+  size_t size() const { return pending.size(); }
+
+  void push_back(const Request& request) {
+    pending.push_back(request);
+    if (request.jdk_id == Request::Jdk::GC) {
+      num_gc_reqs += 1;
+    } else if (request.jdk_id == Request::Jdk::NonGC) {
+      num_nongc_reqs += 1;
+    } else {
+      num_non_jdk_reqs += 1;
+    }
+    assert((num_gc_reqs + num_nongc_reqs + num_non_jdk_reqs) == pending.size());
+  }
+
+  void pop_front() {
+    if (!pending.empty()) {
+      Request req = pending.front();
+      if (req.jdk_id == Request::Jdk::GC) {
+        num_gc_reqs -= 1;
+        assert(num_non_jdk_reqs >= 0);
+      } else if (req.jdk_id == Request::Jdk::NonGC) {
+        num_nongc_reqs -= 1;
+        assert(num_non_jdk_reqs >= 0);
+      } else {
+        num_non_jdk_reqs -= 1;
+        assert(num_non_jdk_reqs >= 0);
+      }
+      pending.pop_front();
+    }
+  }
+
+  Request& get(int i) {
+    return pending[i];
+  }
+};
+
+}        // namespace Ramulator
