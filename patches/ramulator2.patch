+    bool send(Request& req) override {
+      req.final_command = m_dram->m_request_translations(req.type_id);
+
+      switch (req.type_id) {
+        case Request::Type::Read: {
+          s_num_read_reqs++;
+         
+          if (req.jdk_id == Request::Jdk::GC) {
+            s_num_gc_read_reqs++;
+          } else if (req.jdk_id == Request::Jdk::NonGC) {
+            s_num_non_gc_read_reqs++;
+          }
+          break;
+        }
+        case Request::Type::Write: {
+          s_num_write_reqs++;
+         
+          if (req.jdk_id == Request::Jdk::GC) {
+            s_num_gc_write_reqs++;
+          } else if (req.jdk_id == Request::Jdk::NonGC) {
+            s_num_non_gc_write_reqs++;
+          }
+          break;
+        }
+        default: {
+          s_num_other_reqs++;
+         
+          if (req.jdk_id == Request::Jdk::GC) {
+            s_num_gc_other_reqs++;
+          } else if (req.jdk_id == Request::Jdk::NonGC) {
+            s_num_non_gc_other_reqs++;
+          }
+          break;
+        }
+      }
+
+      // Forward existing write requests to incoming read requests
+      if (req.type_id == Request::Type::Read) {
+        auto compare_addr = [req](const Request& wreq) {
+          return wreq.addr == req.addr;
+        };
+        if (std::find_if(m_write_buffer.begin(), m_write_buffer.end(), compare_addr) != m_write_buffer.end()) {
+          // The request will depart at the next cycle
+          req.arrive = m_clk;
+          req.rdwr_clk = m_clk;
+          req.depart = m_clk + 1;
+          pending.push_back(req);
+          s_num_forwarded_reqs++;
+          if (req.jdk_id == Request::Jdk::GC) {
+            s_num_gc_forwarded_reqs++;
+          } else if (req.jdk_id == Request::Jdk::NonGC) {
+            s_num_non_gc_forwarded_reqs++;
+          }
+          return true;
+        }
+      }
+
+      // Else, enqueue them to corresponding buffer based on request type id
+      bool is_success = false;
+      req.arrive = m_clk;
+      if (req.type_id == Request::Type::Read) {
+        is_success = m_read_buffer.enqueue(req);
+        if (!is_success) {
+          s_num_read_buffer_full_reqs++;
+          if (req.jdk_id == Request::Jdk::GC) {
+            s_num_gc_read_buffer_full_reqs++;
+          } else if (req.jdk_id == Request::Jdk::NonGC) {
+            s_num_non_gc_read_buffer_full_reqs++;
+          }
+        }
+      } else if (req.type_id == Request::Type::Write) {
+        is_success = m_write_buffer.enqueue(req);
+        if (!is_success) {
+          s_num_write_buffer_full_reqs++;
+          if (req.jdk_id == Request::Jdk::GC) {
+            s_num_gc_write_buffer_full_reqs++;
+          } else if (req.jdk_id == Request::Jdk::NonGC) {
+            s_num_non_gc_write_buffer_full_reqs++;
+          }
+        }
+      } else {
+        throw std::runtime_error("Invalid request type!");
+      }
+      if (!is_success) {
+        // We could not enqueue the request
+        req.arrive = -1;
+        return false;
+      }
+
+      return true;
+    };
+
+    bool priority_send(Request& req) override {
+      req.final_command = m_dram->m_request_translations(req.type_id);
+
+      bool is_success = false;
+      is_success = m_priority_buffer.enqueue(req);
+      return is_success;
+    }
+
+    void tick() override {
+      m_clk++;
+
+      // Update statistics
+      s_queue_len += m_read_buffer.size() + m_write_buffer.size() + m_priority_buffer.size() + pending.size();
+      s_read_queue_len += m_read_buffer.size() + pending.size();
+      s_write_queue_len += m_write_buffer.size();
+      s_priority_queue_len += m_priority_buffer.size();
+
+     
+      s_gc_queue_len += m_read_buffer.num_gc_reqs + m_write_buffer.num_gc_reqs + m_priority_buffer.num_gc_reqs + pending.num_gc_reqs;
+      s_gc_read_queue_len += m_read_buffer.num_gc_reqs + pending.num_gc_reqs;
+      s_gc_write_queue_len += m_write_buffer.num_gc_reqs;
+      s_gc_priority_queue_len += m_priority_buffer.num_gc_reqs;
+
+     
+      s_non_gc_queue_len += m_read_buffer.num_nongc_reqs + m_write_buffer.num_nongc_reqs + m_priority_buffer.num_nongc_reqs + pending.num_nongc_reqs;
+      s_non_gc_read_queue_len += m_read_buffer.num_nongc_reqs + pending.num_nongc_reqs;
+      s_non_gc_write_queue_len += m_write_buffer.num_nongc_reqs;
+      s_non_gc_priority_queue_len += m_priority_buffer.num_nongc_reqs;
+
+      // 1. Serve completed reads
+      serve_completed_reads();
+
+      m_refresh->tick();
+
+      // 2. Try to find a request to serve.
+      ReqBuffer::iterator req_it;
+      ReqBuffer* buffer = nullptr;
+      bool request_found = schedule_request(req_it, buffer);
+
+      // 2.1 Take row policy action
+      m_rowpolicy->update(request_found, req_it);
+
+      // 3. Update all plugins
+      for (auto plugin : m_plugins) {
+        plugin->update(request_found, req_it);
+      }
+
+      // 4. Finally, issue the commands to serve the request
+      if (request_found) {
+        // If we find a real request to serve
+        if (req_it->is_stat_updated == false) {
+          update_request_stats(req_it);
+        }
+       
+        m_dram->issue_command(req_it->command, req_it->addr_vec, req_it->jdk_id);
+
+        // If we are issuing the last command, set depart clock cycle and move the request to the pending queue
+        if (req_it->command == req_it->final_command) {
+          if (req_it->type_id == Request::Type::Read) {
+            req_it->depart = m_clk + m_dram->m_read_latency;
+            pending.push_back(*req_it);
+          } else if (req_it->type_id == Request::Type::Write) {
+            // TODO: Add code to update statistics
+          }
+          buffer->remove(req_it);
+        } else {
+          if (m_dram->m_command_meta(req_it->command).is_opening) {
+            m_active_buffer.enqueue(*req_it);
+            buffer->remove(req_it);
+          }
+        }
+
+      }
+
+    };
+
+
+  private:
+    /**
+     * @brief    Helper function to check if a request is hitting an open row
+     * @details
+     *
+     */
+    bool is_row_hit(ReqBuffer::iterator& req)
+    {
+        return m_dram->check_rowbuffer_hit(req->final_command, req->addr_vec);
+    }
+    /**
+     * @brief    Helper function to check if a request is opening a row
+     * @details
+     *
+    */
+    bool is_row_open(ReqBuffer::iterator& req)
+    {
+        return m_dram->check_node_open(req->final_command, req->addr_vec);
+    }
+
+    /**
+     * @brief
+     * @details
+     *
+     */
+    void update_request_stats(ReqBuffer::iterator& req)
+    {
+      req->is_stat_updated = true;
+
+      if (req->type_id == Request::Type::Read)
+      {
+        if (is_row_hit(req)) {
+          s_read_row_hits++;
+          s_row_hits++;
+          if (req->source_id != -1)
+            s_read_row_hits_per_core[req->source_id]++;
+         
+          if (req->jdk_id == Request::Jdk::GC) {
+            s_gc_read_row_hits++;
+            s_gc_row_hits++;
+          } else if (req->jdk_id == Request::Jdk::NonGC) {
+            s_non_gc_read_row_hits++;
+            s_non_gc_row_hits++;
+          }
+        } else if (is_row_open(req)) {
+          s_read_row_conflicts++;
+          s_row_conflicts++;
+          if (req->source_id != -1)
+            s_read_row_conflicts_per_core[req->source_id]++;
+         
+          if (req->jdk_id == Request::Jdk::GC) {
+            s_gc_read_row_conflicts++;
+            s_gc_row_conflicts++;
+          } else if (req->jdk_id == Request::Jdk::NonGC) {
+            s_non_gc_read_row_conflicts++;
+            s_non_gc_row_conflicts++;
+          }
+        } else {
+          s_read_row_misses++;
+          s_row_misses++;
+          if (req->source_id != -1)
+            s_read_row_misses_per_core[req->source_id]++;
+         
+          if (req->jdk_id == Request::Jdk::GC) {
+            s_gc_read_row_misses++;
+            s_gc_row_misses++;
+          } else if (req->jdk_id == Request::Jdk::NonGC) {
+            s_non_gc_read_row_misses++;
+            s_non_gc_row_misses++;
+          }
+        }
+      }
+      else if (req->type_id == Request::Type::Write)
+      {
+        if (is_row_hit(req)) {
+          s_write_row_hits++;
+          s_row_hits++;
+         
+          if (req->jdk_id == Request::Jdk::GC) {
+            s_gc_write_row_hits++;
+            s_gc_row_hits++;
+          } else if (req->jdk_id == Request::Jdk::NonGC) {
+            s_non_gc_write_row_hits++;
+            s_non_gc_row_hits++;
+          }
+        } else if (is_row_open(req)) {
+          s_write_row_conflicts++;
+          s_row_conflicts++;
+         
+          if (req->jdk_id == Request::Jdk::GC) {
+            s_gc_write_row_conflicts++;
+            s_gc_row_conflicts++;
+          } else if (req->jdk_id == Request::Jdk::NonGC) {
+            s_non_gc_write_row_conflicts++;
+            s_non_gc_row_conflicts++;
+          }
+        } else {
+          s_write_row_misses++;
+          s_row_misses++;
+         
+          if (req->jdk_id == Request::Jdk::GC) {
+            s_gc_write_row_misses++;
+            s_gc_row_misses++;
+          } else if (req->jdk_id == Request::Jdk::NonGC) {
+            s_non_gc_write_row_misses++;
+            s_non_gc_row_misses++;
+          }
+        }
+      }
+    }
+
+    /**
+     * @brief    Helper function to serve the completed read requests
+     * @details
+     * This function is called at the beginning of the tick() function.
+     * It checks the pending queue to see if the top request has received data from DRAM.
+     * If so, it finishes this request by calling its callback and poping it from the pending queue.
+     */
+    void serve_completed_reads() {
+      if (pending.size()) {
+        // Check the first pending request
+       
+        auto& req = pending.get(0);
+        if (req.depart <= m_clk) {
+          // Request received data from dram
+          if (req.depart - req.arrive >= 1) {
+            // Check if this requests accesses the DRAM or is being forwarded.
+            // TODO add the stats back
+            // if (req.depart - req.arrive > 1000) {
+            //     m_logger->warn("WARN: Request is taking too long (arrive: {:12}, depart: {:12}, diff: {:12}, act: {:12}, priority: {:12}, rdwr: {:12}, addr: {:12}, jdk_id: {:4}, read req count: {:12})", req.arrive, req.depart, req.depart - req.arrive, req.active_clk, req.priority_clk, req.rdwr_clk, req.addr, req.jdk_id, s_num_read_reqs);
+            // } 
+            // else {
+            //  m_logger->warn("INFO: Request (arrive: {:12}, depart: {:12}, diff: {:12}, act: {:12}, priority: {:12}, rdwr: {:12}, addr: {:12}, jdk_id: {:4}, read req count: {:12})", req.arrive, req.depart, req.depart - req.arrive, req.active_clk, req.priority_clk, req.rdwr_clk, req.addr, req.jdk_id, s_num_read_reqs);
+            // }
+            s_read_latency += req.depart - req.arrive;
+            s_arrive_to_scheduled_read_latency += req.rdwr_clk - req.arrive;
+            s_scheduled_to_depart_read_latency += req.depart - req.rdwr_clk;
+            s_read_latency_samples++;
+           
+            if (req.jdk_id == Request::Jdk::GC) {
+              s_gc_read_latency += req.depart - req.arrive;
+              s_gc_arrive_to_scheduled_read_latency += req.rdwr_clk - req.arrive;
+              s_gc_scheduled_to_depart_read_latency += req.depart - req.rdwr_clk;
+              s_gc_read_latency_samples++;
+            } else if (req.jdk_id == Request::Jdk::NonGC) {
+              s_non_gc_read_latency += req.depart - req.arrive;
+              s_non_gc_arrive_to_scheduled_read_latency += req.rdwr_clk - req.arrive;
+              s_non_gc_scheduled_to_depart_read_latency += req.depart - req.rdwr_clk;
+              s_non_gc_read_latency_samples++;
+            }
+          }
+
+          if (req.callback) {
+            // If the request comes from outside (e.g., processor), call its callback
+            req.callback(req);
+          }
+          // Finally, remove this request from the pending queue
+          pending.pop_front();
+        }
+      };
+    };
+
+
+    /**
+     * @brief    Checks if we need to switch to write mode
+     *
+     */
+    void set_write_mode() {
+      if (!m_is_write_mode) {
+        if ((m_write_buffer.size() > m_wr_high_watermark * m_write_buffer.max_size) || m_read_buffer.size() == 0) {
+          m_is_write_mode = true;
+        }
+      } else {
+        if ((m_write_buffer.size() < m_wr_low_watermark * m_write_buffer.max_size) && m_read_buffer.size() != 0) {
+          m_is_write_mode = false;
+        }
+      }
+    };
+
+
+    /**
+     * @brief    Helper function to find a request to schedule from the buffers.
+     *
+     */
+    bool schedule_request(ReqBuffer::iterator& req_it, ReqBuffer*& req_buffer) {
+      bool request_found = false;
+      // 2.1    First, check the act buffer to serve requests that are already activating (avoid useless ACTs)
+      if (req_it= m_scheduler->get_best_request(m_active_buffer); req_it != m_active_buffer.end()) {
+        if (m_dram->check_ready(req_it->command, req_it->addr_vec)) {
+          request_found = true;
+          req_buffer = &m_active_buffer;
+          req_it->active_clk = m_clk;
+
+          s_num_scheduled_active++;
+          if (req_it->jdk_id == Request::Jdk::GC) {
+            s_num_scheduled_gc_active++;
+          } else if (req_it->jdk_id == Request::Jdk::NonGC) {
+            s_num_scheduled_non_gc_active++;
+          }
+        }
+      }
+
+      // 2.2    If no requests can be scheduled from the act buffer, check the rest of the buffers
+      if (!request_found) {
+        // 2.2.1    We first check the priority buffer to prioritize e.g., maintenance requests
+        if (m_priority_buffer.size() != 0) {
+          req_buffer = &m_priority_buffer;
+          req_it = m_priority_buffer.begin();
+          req_it->command = m_dram->get_preq_command(req_it->final_command, req_it->addr_vec);
+
+          request_found = m_dram->check_ready(req_it->command, req_it->addr_vec);
+          if (!request_found & m_priority_buffer.size() != 0) {
+            return false;
+          }
+
+          if (request_found) {
+            req_it->priority_clk = m_clk;
+            s_num_scheduled_priority++;
+          }
+        }
+
+        // 2.2.1    If no request to be scheduled in the priority buffer, check the read and write buffers.
+        if (!request_found) {
+          // Query the write policy to decide which buffer to serve
+          set_write_mode();
+          auto& buffer = m_is_write_mode ? m_write_buffer : m_read_buffer;
+          if (req_it = m_scheduler->get_best_request(buffer); req_it != buffer.end()) {
+            request_found = m_dram->check_ready(req_it->command, req_it->addr_vec);
+            req_buffer = &buffer;
+
+            if (request_found) {
+              s_num_scheduled_rdwr++;
+              req_it->rdwr_clk = m_clk;
+              if (req_it->jdk_id == Request::Jdk::GC) {
+                s_num_scheduled_gc_rdwr++;
+              } else if (req_it->jdk_id == Request::Jdk::NonGC) {
+                s_num_scheduled_non_gc_rdwr++;
+              }
+            }
+          }
+        }
+      }
+
+      // 2.3 If we find a request to schedule, we need to check if it will close an opened row in the active buffer.
+      if (request_found) {
+        if (m_dram->m_command_meta(req_it->command).is_closing) {
+          auto& rowgroup = req_it->addr_vec;
+          for (auto _it = m_active_buffer.begin(); _it != m_active_buffer.end(); _it++) {
+            auto& _it_rowgroup = _it->addr_vec;
+            bool is_matching = true;
+            for (int i = 0; i < m_bank_addr_idx + 1 ; i++) {
+              if (_it_rowgroup[i] != rowgroup[i] && _it_rowgroup[i] != -1 && rowgroup[i] != -1) {
+                is_matching = false;
+                break;
+              }
+            }
+            if (is_matching) {
+              request_found = false;
+              break;
+            }
+          }
+        }
+      }
+
+      return request_found;
+    }
+
+    std::string finalize() override {
+      s_avg_read_latency = (float) s_read_latency / (float) s_read_latency_samples;
+
+      s_avg_gc_read_latency = (float) s_gc_read_latency / (float) s_gc_read_latency_samples;
+      s_avg_non_gc_read_latency = (float) s_non_gc_read_latency / (float) s_non_gc_read_latency_samples;
+
+      s_avg_arrive_to_scheduled_read_latency = (float) s_arrive_to_scheduled_read_latency / (float) s_read_latency_samples;
+      s_avg_gc_arrive_to_scheduled_read_latency = (float) s_gc_arrive_to_scheduled_read_latency / (float) s_gc_read_latency_samples;
+      s_avg_non_gc_arrive_to_scheduled_read_latency = (float) s_non_gc_arrive_to_scheduled_read_latency / (float) s_non_gc_read_latency_samples;
+
+      s_avg_scheduled_to_depart_read_latency = (float) s_scheduled_to_depart_read_latency / (float) s_read_latency_samples;
+      s_avg_gc_scheduled_to_depart_read_latency = (float) s_gc_scheduled_to_depart_read_latency / (float) s_gc_read_latency_samples;
+      s_avg_non_gc_scheduled_to_depart_read_latency = (float) s_non_gc_scheduled_to_depart_read_latency / (float) s_non_gc_read_latency_samples;
+
+      s_queue_len_avg = (float) s_queue_len / (float) m_clk;
+      s_read_queue_len_avg = (float) s_read_queue_len / (float) m_clk;
+      s_write_queue_len_avg = (float) s_write_queue_len / (float) m_clk;
+      s_priority_queue_len_avg = (float) s_priority_queue_len / (float) m_clk;
+
+      s_gc_queue_len_avg = (float) s_gc_queue_len / (float) m_clk;
+      s_gc_read_queue_len_avg = (float) s_gc_read_queue_len / (float) m_clk;
+      s_gc_write_queue_len_avg = (float) s_gc_write_queue_len / (float) m_clk;
+      s_gc_priority_queue_len_avg = (float) s_gc_priority_queue_len / (float) m_clk;
+
+     
+      s_non_gc_queue_len_avg = (float) s_non_gc_queue_len / (float) m_clk;
+      s_non_gc_read_queue_len_avg = (float) s_non_gc_read_queue_len / (float) m_clk;
+      s_non_gc_write_queue_len_avg = (float) s_non_gc_write_queue_len / (float) m_clk;
+      s_non_gc_priority_queue_len_avg = (float) s_non_gc_priority_queue_len / (float) m_clk;
+
+      return "";
+    }
+
+};
+
+}   // namespace Ramulator
