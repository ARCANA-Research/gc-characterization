+#include <vector>
+#include <unordered_map>
+#include <limits>
+#include <random>
+#include <filesystem>
+#include <fstream>
+
+#include "base/base.h"
+#include "dram_controller/controller.h"
+#include "dram_controller/plugin.h"
+#include "frontend/frontend.h"
+
+namespace Ramulator {
+
+class CommandCounter : public IControllerPlugin, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IControllerPlugin, CommandCounter, "CommandCounter", "Counting the number of issued commands.")
+
+  private:
+    IDRAM* m_dram = nullptr;
+
+    std::vector<std::string> m_commands_to_count;
+    std::unordered_map<int, int> m_command_counters;
+
+   
+    std::unordered_map<int, int> m_gc_command_counters;
+    std::unordered_map<int, int> m_non_gc_command_counters;
+    IFrontEnd* frontend_ptr;
+
+  public:
+    void init() override {
+      m_commands_to_count = param<std::vector<std::string>>("commands_to_count").desc("A list of commands to be counted").required();
+    };
+
+    void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override {
+      frontend_ptr = frontend;
+      m_ctrl = cast_parent<IDRAMController>();
+      m_dram = m_ctrl->m_dram;
+
+      for (const auto& command_name : m_commands_to_count) {
+        if (!m_dram->m_commands.contains(command_name)) {
+          throw ConfigurationError("Command {} does not exist in the DRAM standard {}!", command_name, m_dram->get_name());
+        }
+        m_command_counters[m_dram->m_commands(command_name)] = 0;
+
+       
+        m_gc_command_counters[m_dram->m_commands(command_name)] = 0;
+        m_non_gc_command_counters[m_dram->m_commands(command_name)] = 0;
+      }
+    };
+
+    void update(bool request_found, ReqBuffer::iterator& req_it) override {
+      if (request_found) {
+        m_command_counters[req_it->command]++;
+
+       
+        if (req_it->jdk_id == Request::Jdk::GC) {
+            m_gc_command_counters[req_it->command]++;
+        } else if (req_it->jdk_id == Request::Jdk::NonGC) {
+            m_non_gc_command_counters[req_it->command]++;
+        }
+      }
+    };
+
+   
+    std::string finalize() override {
+      std::string cmd_stats = "========== BEGIN CMD COUNTER STATS ==========\n";
+
+      for (const auto& [cmd_id, count] : m_command_counters) {
+        cmd_stats += fmt::format("{}, {}\n", m_dram->m_commands(cmd_id), count);
+      }
+
+      for (const auto& [cmd_id, count] : m_gc_command_counters) {
+        cmd_stats += fmt::format("GC->{}, {}\n", m_dram->m_commands(cmd_id), count);
+      }
+
+      for (const auto& [cmd_id, count] : m_non_gc_command_counters) {
+        cmd_stats += fmt::format("NonGC->{}, {}\n", m_dram->m_commands(cmd_id), count);
+      }
+
+      cmd_stats += "=========== END CMD COUNTER STATS ===========\n";
+
+      return cmd_stats;
+    }
+
+};
+
+}       // namespace Ramulator
