+#include "memory_system/memory_system.h"
+#include "translation/translation.h"
+#include "dram_controller/controller.h"
+#include "addr_mapper/addr_mapper.h"
+#include "dram/dram.h"
+
+namespace Ramulator {
+
+class JdkDRAMSystem final : public IMemorySystem, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IMemorySystem, JdkDRAMSystem, "JdkDRAM", "Jdk DRAM-based memory system.");
+
+  protected:
+    Clk_t m_clk = 0;
+    IDRAM*  m_dram;
+    IAddrMapper*  m_addr_mapper;
+    std::vector<IDRAMController*> m_controllers;
+
+  public:
+    int s_num_read_requests = 0;
+    int s_num_write_requests = 0;
+    int s_num_other_requests = 0;
+
+   
+    int s_num_gc_read_requests = 0;
+    int s_num_gc_write_requests = 0;
+    int s_num_gc_other_requests = 0;
+
+    int s_num_non_gc_read_requests = 0;
+    int s_num_non_gc_write_requests = 0;
+    int s_num_non_gc_other_requests = 0;
+
+    int s_stat_jdk_execution_phase = 0;
+    int s_curr_jdk_execution_phase = 0;
+
+  public:
+    void init() override {
+      // Create device (a top-level node wrapping all channel nodes)
+      m_dram = create_child_ifce<IDRAM>();
+      m_addr_mapper = create_child_ifce<IAddrMapper>();
+
+      int num_channels = m_dram->get_level_size("channel");
+
+      // Create memory controllers
+      for (int i = 0; i < num_channels; i++) {
+        IDRAMController* controller = create_child_ifce<IDRAMController>();
+        controller->m_impl->set_id(fmt::format("Channel {}", i));
+        controller->m_channel_id = i;
+        m_controllers.push_back(controller);
+      }
+
+      m_clock_ratio = param<uint>("clock_ratio").required();
+
+      register_stat(m_clk).name("memory_system_cycles");
+      register_stat(s_num_read_requests).name("total_num_read_requests");
+      register_stat(s_num_write_requests).name("total_num_write_requests");
+      register_stat(s_num_other_requests).name("total_num_other_requests");
+
+     
+      register_stat(s_num_gc_read_requests).name("total_num_gc_read_requests");
+      register_stat(s_num_gc_write_requests).name("total_num_gc_write_requests");
+      register_stat(s_num_gc_other_requests).name("total_num_gc_other_requests");
+
+      register_stat(s_num_non_gc_read_requests).name("total_num_non_gc_read_requests");
+      register_stat(s_num_non_gc_write_requests).name("total_num_non_gc_write_requests");
+      register_stat(s_num_non_gc_other_requests).name("total_num_non_gc_other_requests");
+
+     
+      register_stat(s_stat_jdk_execution_phase).name("jdk_execution_phase");
+    };
+
+    void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override { }
+
+   
+    void set_jdk_execution_phase(int new_execution_phase) override {
+      s_stat_jdk_execution_phase = s_curr_jdk_execution_phase;
+      s_curr_jdk_execution_phase = new_execution_phase;
+      write_trace("SWITCH JDK PHASE -> " + std::to_string(s_curr_jdk_execution_phase));
+    }
+
+    bool send(Request req) override {
+     
+      req.jdk_phase = s_curr_jdk_execution_phase;
+
+      m_addr_mapper->apply(req);
+      int channel_id = req.addr_vec[0];
+      bool is_success = m_controllers[channel_id]->send(req);
+
+     
+      write_trace(req, m_clk, is_success);
+
+      if (is_success) {
+        switch (req.type_id) {
+          case Request::Type::Read: {
+            s_num_read_requests++;
+            if (req.jdk_id == Request::Jdk::GC) {
+              s_num_gc_read_requests++;
+            } else if (req.jdk_id == Request::Jdk::NonGC) {
+              s_num_non_gc_read_requests++;
+            }
+            break;
+          }
+          case Request::Type::Write: {
+            s_num_write_requests++;
+            if (req.jdk_id == Request::Jdk::GC) {
+              s_num_gc_write_requests++;
+            } else if (req.jdk_id == Request::Jdk::NonGC) {
+              s_num_non_gc_write_requests++;
+            }
+            break;
+          }
+          default: {
+            s_num_other_requests++;
+            if (req.jdk_id == Request::Jdk::GC) {
+              s_num_gc_other_requests++;
+            } else if (req.jdk_id == Request::Jdk::NonGC) {
+              s_num_non_gc_other_requests++;
+            }
+            break;
+          }
+        }
+      }
+
+      return is_success;
+    };
+
+    void tick() override {
+      m_clk++;
+      m_dram->tick();
+      for (auto controller : m_controllers) {
+        controller->tick();
+      }
+    };
+
+    float get_tCK() override {
+      return m_dram->m_timing_vals("tCK_ps") / 1000.0f;
+    }
+
+    Clk_t get_clk() override {
+      return m_clk;
+    }
+
+    // const SpecDef& get_supported_requests() override {
+    //   return m_dram->m_requests;
+    // };
+};
+
+}   // namespace
