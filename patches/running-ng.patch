+    def str_replace_tokens(self, curr_val: str, tokens: Dict) -> str:
+        potential_tokens = list(re.finditer(r"@[A-Z]+", curr_val))
+        if len(potential_tokens) == 0:
+            return curr_val
+        new_val = ""
+        curr_pos = 0
+        for potential_token in potential_tokens:
+            new_val += self.fail_safe_substring(
+                curr_val, curr_pos, potential_token.span()[0]
+            )
+            tk = potential_token.group()[1:]
+            if tk in tokens:
+                if type(tokens[tk]) is str:
+                    new_val += tokens[tk]
+                else:
+                    new_val += str(tokens[tk])
+            else:
+                new_val += f"@{tk}"
+            curr_pos = potential_token.span()[1]
+        new_val += self.fail_safe_substring(curr_val, curr_pos, len(curr_val))
+        return new_val
+
