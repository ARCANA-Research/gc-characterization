+@register(BenchmarkSuite)
+class Renaissance(JavaBenchmarkSuite):
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.release: str
+        self.release = kwargs["release"]
+        if self.release not in ["0.16.1"]:
+            raise ValueError(
+                "Renaissance release {} not recognized".format(self.release)
+            )
+        self.path: Path
+        self.path = Path(os.path.expandvars(kwargs["path"]))
+        if not self.path.exists():
+            logging.warning("Renaissance jar {} not found".format(self.path))
+        self.minheap: Optional[str]
+        self.minheap = kwargs.get("minheap")
+        self.minheap_values: Dict[str, Dict[str, int]]
+        self.minheap_values = kwargs.get("minheap_values", {})
+        if not isinstance(self.minheap_values, dict):
+            raise TypeError(
+                "The minheap_values of {} should be a dictionary".format(self.name)
+            )
+        if self.minheap:
+            if not isinstance(self.minheap, str):
+                raise TypeError(
+                    "The minheap of {} should be a string that selects from a minheap_values".format(
+                        self.name
+                    )
+                )
+            if self.minheap not in self.minheap_values:
+                raise KeyError(
+                    "{} is not a valid entry of {}.minheap_values".format(
+                        self.name, self.name
+                    )
+                )
+        self.timing_iteration = Optional[int]
+        self.timing_iteration = kwargs.get("timing_iteration")
+        assert self.timing_iteration
+        self.plugin: Optional[str]
+        self.plugin = kwargs.get("plugin")
+        self.timeout: Optional[int]
+        self.timeout = kwargs.get("timeout")
+        self.prepend: Optional[str]
+        self.prepend = kwargs.get("prepend")
+        self.monitors: Optional[List[str]]
+        self.monitors = kwargs.get("monitors")
+        self.execution_dump: Optional[str]
+        self.execution_dump = kwargs.get("execution_dump")
+        self.delay_execution: Optional[float]
+        self.delay_execution = kwargs.get("delay_execution")
+        if self.delay_execution is not None:
+            self.delay_execution = float(self.delay_execution)
+        self.scratch_directory: Optional[str]
+        self.scratch_directory = kwargs.get("scratch_directory")
+
+    def __str__(self) -> str:
+        return "{} Renaissance {} {}".format(super().__str__(), self.release, self.path)
+
+    def get_benchmark(self, bm_spec: Union[str, Dict[str, Any]]) -> "JavaBenchmark":
+        timing_iteration = self.timing_iteration
+        timeout = self.timeout
+        scratch_directory = self.scratch_directory
+        if type(bm_spec) is str:
+            bm_name = bm_spec
+            name = bm_spec
+        else:
+            assert type(bm_spec) is dict
+            if "bm_name" not in bm_spec or "name" not in bm_spec:
+                raise KeyError(
+                    "When a dictionary is used to speicfy a benchmark, you need to provide both `name` and `bm_name`"
+                )
+            bm_name = bm_spec["bm_name"]
+            name = bm_spec["name"]
+            if "timing_iteration" in bm_spec:
+                timing_iteration = bm_spec["timing_iteration"]
+            if "timeout" in bm_spec:
+                timeout = bm_spec["timeout"]
+        if self.plugin:
+            cp = [str(self.path)]
+            program_args = ["org.renaissance.core.Launcher", "--plugin", self.plugin]
+        else:
+            cp = []
+            program_args = ["-jar", str(self.path)]
+        # Timing iteration
+        program_args.extend(["-r", str(timing_iteration)])
+        if scratch_directory:
+            program_args.extend(["--scratch-base", scratch_directory])
+            # program_args.extend(["--keep-scratch"])
+        # Name of the benchmark
+        program_args.append(bm_name)
+
+        return JavaBenchmark(
+            jvm_args=[],
+            program_args=program_args,
+            cp=cp,
+            suite_name=self.name,
+            name=name,
+            timeout=timeout,
+            prepend=self.get_prepend(),
+            monitors=self.get_monitors(),
+            execution_dump=self.get_execution_dump(),
+            delay_execution=self.get_delay_execution(),
+        )
+
+    def get_minheap(self, bm: Benchmark) -> int:
+        assert isinstance(bm, JavaBenchmark)
+        name = bm.name
+        if not self.minheap:
+            logging.warning("No minheap_value of {} is selected".format(self))
+            return DEFAULT_MINHEAP
+        minheap = self.minheap_values[self.minheap]
+        if name not in minheap:
+            logging.warning("Minheap for {} of {} not set".format(name, self))
+            return DEFAULT_MINHEAP
+        return minheap[name]
+
+    def is_passed(self, output: bytes) -> bool:
+        return f"{self.timing_iteration - 1} completed".encode("ascii") in output
+
+    def get_prepend(self) -> Optional[str]:
+        return self.prepend
+
+    def get_monitors(self) -> Optional[List[str]]:
+        return self.monitors
+
+    def get_execution_dump(self) -> Optional[str]:
+        return self.execution_dump
+
+    def get_delay_execution(self) -> Optional[float]:
+        return self.delay_execution
