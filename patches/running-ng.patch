+class SpecCPUBenchmark(Benchmark):
+    def __init__(self, program_args: List[str], **kwargs):
+        super().__init__(**kwargs)
+        self.spec_args = list()
+        self.program_args = program_args
+
+    def __str__(self) -> str:
+        return self.to_string(DummyRuntime("runcpu"))
+
+    def attach_modifiers(self, modifiers: Sequence[Modifier]) -> "SpecCPUBenchmark":
+        bb = super().attach_modifiers(modifiers)
+        for m in modifiers:
+            if not m.should_attach(self.suite_name, self.name) or type(m) == EnvVar:
+                continue
+            elif type(m) == SpecCPUArg:
+                bb.spec_args.extend(m.val)
+            else:
+                logging.warning(f"{type(m)} not respected by SpecCPUBenchmark")
+        return bb
+
+    def get_tokens(self) -> Dict[str, str]:
+        return {
+            "BMNAME": self.name,
+        }
+
+    def get_full_args(self, runtime: Runtime) -> List[Union[str, Path]]:
+        cmd = super().get_full_args(runtime)
+        cmd.append(runtime.get_executable())
+        cmd.extend(self.program_args)
+        cmd.extend(self.spec_args)
+        cmd.extend([self.name])
+        return cmd
